# IDE / Editors
.idea/
.zencoder/
~*
~*.*
.~*
*.kate-swp

# Рабочие папки задач (git worktree) — внутри проекта, не в репозитории
/.worktrees/

# Claude Code — служебные runtime-файлы (не для шаринга)
.claude/*.lock
.claude/settings.local.json

# Python
venv/
env/
__pycache__/
*.pyc
*.pyo
dist/
build/
*.egg-info/
.coverage

# Logs
*.log
*.log.*
log/

# Secrets / config
.env
.secrets.*
.secrets.toml
secrets.env

# Local utilities
copy_to_remote.sh
vanilla_docker.sh

# Caches
.cache/

# Local SQLite
*.sqlite

# Temp / docs builds
temp/
doc/

# Сгенерированные документы примера
examples/output/

# OpenCode local runtime and private legacy migration files
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock*
.opencode/settings.local.json
.claude/settings.local.json
.claude/*.lock
.worktrees/
